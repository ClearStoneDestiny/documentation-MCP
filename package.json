{
  "name": "documentation-mcp",
  "version": "0.1.0",
  "private": true,
  "description": "A local MCP server for version-aware library and framework documentation.",
  "type": "module",
  "bin": {
    "documentation-mcp": "dist/main.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "dev": "tsx watch src/main.ts",
    "typecheck": "tsc --noEmit",
    "inspector": "npm run build && mcp-inspector node dist/main.js",
    "test": "npm run build && vitest run"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ClearStoneDestiny/documentation-MCP.git"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "2.3.1",
    "@nestjs/common": "12.2.0",
    "@nestjs/core": "12.2.0",
    "github-slugger": "2.0.0",
    "mdast-util-to-string": "4.0.0",
    "reflect-metadata": "0.2.2",
    "remark-frontmatter": "5.0.0",
    "remark-parse": "11.0.0",
    "rxjs": "7.8.2",
    "unified": "11.0.5",
    "yaml": "2.9.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "2.3.1",
    "@modelcontextprotocol/inspector": "2.12.0",
    "@types/mdast": "4.0.4",
    "@types/node": "22.20.5",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vitest": "5.0.5"
  }
}
